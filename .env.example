# Environment variables for Docker Compose (hostnames match service names below).
# For local dev without Docker for the app, copy archetypes/api.env.example instead.
#
# See src/config/configuration.ts for how each variable is loaded.

# --- API ---
NODE_ENV=development
PORT=3000
SERVICE_NAME=hypatia-service

# --- PostgreSQL ---
POSTGRES_USER=hypatia
POSTGRES_PASSWORD=hypatia
POSTGRES_DB=hypatia
# Host "postgres" is the docker-compose service name
DATABASE_URL=postgresql://hypatia:hypatia@postgres:5432/hypatia?schema=public

# --- Redis ---
REDIS_PASSWORD=hypatia-redis-dev
REDIS_URL=redis://:hypatia-redis-dev@redis:6379

# --- Auth (Argus JWT or interim internal API key) ---
# At least one is required in production — see src/config/configuration.ts
INTERNAL_API_KEY=change-me-local-dev
# ARGUS_JWT_SECRET=

# --- RabbitMQ ---
# off       = no messaging (Hades early phase, services without events)
# publisher = api archetype (Athena, Midas) — emits events
# consumer  = worker archetype (Hermes) — see archetypes/worker.env.example
RABBITMQ_MODE=publisher
RABBITMQ_USER=hypatia
RABBITMQ_PASSWORD=hypatia-rabbitmq-dev
RABBITMQ_URL=amqp://hypatia:hypatia-rabbitmq-dev@rabbitmq:5672
RABBITMQ_EXCHANGE=hypatia.events
RABBITMQ_DLX_EXCHANGE=hypatia.events.dlx
# Unique per service — change when scaffolding (e.g. athena-core.events)
RABBITMQ_QUEUE=hypatia-service.events
