# Api archetype — local dev with `npm run start:dev` (localhost hostnames).
# Copy to .env:  cp archetypes/api.env.example .env

NODE_ENV=development
PORT=3000
SERVICE_NAME=hypatia-service

POSTGRES_USER=hypatia
POSTGRES_PASSWORD=hypatia
POSTGRES_DB=hypatia
DATABASE_URL=postgresql://hypatia:hypatia@localhost:5432/hypatia?schema=public

REDIS_PASSWORD=hypatia-redis-dev
REDIS_URL=redis://:hypatia-redis-dev@localhost:6379

INTERNAL_API_KEY=change-me-local-dev
# ARGUS_JWT_SECRET=

RABBITMQ_MODE=publisher
RABBITMQ_USER=hypatia
RABBITMQ_PASSWORD=hypatia-rabbitmq-dev
RABBITMQ_URL=amqp://hypatia:hypatia-rabbitmq-dev@localhost:5672
RABBITMQ_EXCHANGE=hypatia.events
RABBITMQ_DLX_EXCHANGE=hypatia.events.dlx
RABBITMQ_QUEUE=hypatia-service.events
