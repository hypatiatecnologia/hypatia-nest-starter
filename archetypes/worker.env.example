# Worker archetype — consumes RabbitMQ, exposes only /health over HTTP.
# Copy to .env:  cp archetypes/worker.env.example .env
#
# Register handlers in src/modules/<feature>/*-event.consumer.ts (see example module).

NODE_ENV=development
PORT=3000
SERVICE_NAME=hypatia-worker

POSTGRES_USER=hypatia
POSTGRES_PASSWORD=hypatia
POSTGRES_DB=hypatia
DATABASE_URL=postgresql://hypatia:hypatia@localhost:5432/hypatia?schema=public

REDIS_PASSWORD=hypatia-redis-dev
REDIS_URL=redis://:hypatia-redis-dev@localhost:6379

INTERNAL_API_KEY=change-me-local-dev
# ARGUS_JWT_SECRET=
# ARGUS_JWT_ISSUER=argus
# ARGUS_JWT_AUDIENCE=hypatia-service

# Behind a reverse proxy set TRUST_PROXY=true; tune rate limit if needed.
# TRUST_PROXY=true
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=100

RABBITMQ_MODE=consumer
RABBITMQ_USER=hypatia
RABBITMQ_PASSWORD=hypatia-rabbitmq-dev
RABBITMQ_URL=amqp://hypatia:hypatia-rabbitmq-dev@localhost:5672
RABBITMQ_EXCHANGE=hypatia.events
RABBITMQ_DLX_EXCHANGE=hypatia.events.dlx
RABBITMQ_QUEUE=hypatia-worker.events
