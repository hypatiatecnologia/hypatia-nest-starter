# Worker archetype — consumes RabbitMQ, exposes only /health over HTTP.
# Copy to .env:  cp archetypes/worker.env.example .env
#
# Register handlers in src/modules/<feature>/*-event.consumer.ts (see example module).

NODE_ENV=development
PORT=3000
SERVICE_NAME=hypatia-worker

POSTGRES_USER=hypatia
POSTGRES_PASSWORD=hypatia
POSTGRES_DB=hypatia
DATABASE_URL=postgresql://hypatia:hypatia@localhost:5432/hypatia?schema=public

REDIS_URL=redis://localhost:6379

RABBITMQ_MODE=consumer
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=hypatia.events
RABBITMQ_DLX_EXCHANGE=hypatia.events.dlx
RABBITMQ_QUEUE=hypatia-worker.events
