{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "group:monorepos"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "NestJS packages move together",
      "groupName": "nestjs",
      "matchPackageNames": ["@nestjs/**"]
    },
    {
      "description": "Prisma CLI and client must stay in lockstep",
      "groupName": "prisma",
      "matchPackageNames": ["prisma", "@prisma/client"]
    },
    {
      "description": "Automerge safe dev-tooling patches/minors once CI passes",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "prConcurrentLimit": 5
}
